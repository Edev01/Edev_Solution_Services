# Public
NEXT_PUBLIC_SITE_URL=https://edev.solutions
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=edevsolutions640@gmail.com
SMTP_PASS=your_gmail_app_password_here
CONTACT_FROM=info@edevsolutions.com
CONTACT_TO=info@edevsolutions.com

# MongoDB
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/edev?retryWrites=true&w=majority
MONGODB_DB=edev

# Admin auth
ADMIN_EMAIL=admin@edevsolutions.com
ADMIN_PASSWORD=change-this-strong-password
AUTH_SECRET=generate-a-long-random-secret
# After setting Mongo + admin env, seed once: npm run seed:admin
# To reset password later: npm run seed:admin -- --update

# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=edev-media
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
